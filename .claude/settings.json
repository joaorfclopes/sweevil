{
  "defaultMode": "bypassPermissions",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["snyk"],
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/*.lock)",
      "Read(**/.git/**)",
      "Read(**/*.log)",
      "Read(**/logs/**)",
      "Read(**/.claude/completions/**)",
      "Read(**/.claude/sessions/**)",
      "Read(**/docs/archive/**)"
    ]
  }
}
